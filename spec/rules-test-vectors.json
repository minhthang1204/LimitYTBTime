      "expect": { "allowed": false, "reason": "DailyQuota", "nextChange": "2026-10-27T00:00:00+07:00" } },

    { "name": "het-quota-tuan", "now": "2026-11-01T18:00:00+07:00",
      "usage": [
        { "device": "pc", "date": "2026-10-26", "minutes": 70 }, { "device": "pc", "date": "2026-10-27", "minutes": 70 },
        { "device": "tv", "date": "2026-10-28", "minutes": 70 }, { "device": "tv", "date": "2026-10-29", "minutes": 70 },
        { "device": "pc", "date": "2026-10-30", "minutes": 70 }, { "device": "tv", "date": "2026-10-31", "minutes": 70 } ],
