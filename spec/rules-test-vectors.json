{
  "_comment": "Bộ ca kiểm thử dùng chung cho RulesEngine (C# và Kotlin). 'config' của mỗi case ghi đè nông (theo khoá cấp 1) lên baseConfig. Thời gian theo giờ Việt Nam. 2026-10-26 là Thứ Hai.",
  "baseConfig": {
    "timeZone": "Asia/Ho_Chi_Minh",
    "weekStart": "Mon",
    "weeklyQuotaMinutes": 420,
    "dailyQuotaMinutes": 90,
    "holidayDailyQuotaMinutes": null,
    "blockedWindows": [
      { "days": ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"], "from": "22:00", "to": "06:00" },
      { "days": ["Mon","Tue","Wed","Thu","Fri"], "from": "07:00", "to": "11:00", "schoolOnly": true },
      { "days": ["Mon","Tue","Wed","Thu","Fri"], "from": "13:00", "to": "17:00", "schoolOnly": true }
    ],
    "holidays": [],
    "holidayOverrides": {}
  },
  "cases": [
    { "name": "gio-hoc-buoi-sang", "now": "2026-10-26T09:00:00+07:00",
      "expect": { "allowed": false, "reason": "BlockedWindow", "nextChange": "2026-10-26T11:00:00+07:00" } },

    { "name": "buoi-trua-bi-gioi-han-boi-gio-hoc-chieu", "now": "2026-10-26T12:00:00+07:00",
      "expect": { "allowed": true, "leftMinutes": 60 } },

    { "name": "buoi-trua-da-xem-80-phut", "now": "2026-10-26T12:00:00+07:00",
      "usage": [ { "device": "pc", "date": "2026-10-26", "minutes": 80 } ],
      "expect": { "allowed": true, "leftMinutes": 10 } },

    { "name": "het-quota-ngay", "now": "2026-10-26T18:00:00+07:00",
