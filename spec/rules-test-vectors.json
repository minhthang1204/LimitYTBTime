        { "device": "pc", "date": "2026-10-26", "minutes": 70 }, { "device": "pc", "date": "2026-10-27", "minutes": 70 },
        { "device": "pc", "date": "2026-10-28", "minutes": 70 }, { "device": "pc", "date": "2026-10-29", "minutes": 70 },
        { "device": "pc", "date": "2026-10-30", "minutes": 70 }, { "device": "pc", "date": "2026-10-31", "minutes": 70 },
