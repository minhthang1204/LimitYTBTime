    { "name": "khung-gio-noi-tiep-nhau", "now": "2026-10-26T09:00:00+07:00",
      "config": { "blockedWindows": [
        { "days": ["Mon","Tue","Wed","Thu","Fri","Sat","Sun"], "from": "22:00", "to": "06:00" },
