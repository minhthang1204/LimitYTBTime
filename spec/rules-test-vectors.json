        { "device": "pc", "date": "2026-10-26", "minutes": 80 }, { "device": "pc", "date": "2026-10-27", "minutes": 80 },
        { "device": "pc", "date": "2026-10-28", "minutes": 80 }, { "device": "pc", "date": "2026-10-29", "minutes": 80 },
        { "device": "pc", "date": "2026-10-30", "minutes": 80 } ],
      "expect": { "allowed": true, "leftMinutes": 20 } },

    { "name": "het-ca-quota-ngay-lan-tuan-thi-bao-tuan", "now": "2026-11-01T18:00:00+07:00",
